# Outputs
output/*.mp4
output/*.webm
output/*.mkv
!output/.gitkeep

# Learning log (optional: remove to commit training data)
learning_log.jsonl

# Automation state (local run count, prompts tried)
data/automation_state.json

# Local registry cache (recreated at runtime; D1 is source of truth when API is used)
/knowledge/

# User-supplied loop origin clips (do not commit copyrighted files)
/references/*.mp4
/references/*.mkv
/references/*.webm

# Python
__pycache__/
*.egg-info/
*.py[cod]
*$py.class
.venv/
venv/
env/
.env
.env.local

# IDE
.idea/
.vscode/
*.swp
*.swo

# Models (large downloads)
models/
*.ckpt
*.safetensors
*.bin

# OS
.DS_Store
Thumbs.db
nul

# Cloudflare local dev
cloudflare/.wrangler/
cloudflare/node_modules/

# JSON registry exports (ephemeral snapshots; keep schema doc)
json registry exports/*.json

# Ad hoc CLI scratch output at repo root (color sweeps, coverage snapshots, etc.)
/*.log
/cov*.json
